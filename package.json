  "dependencies": {
    "@better-auth/expo": "^1.7.12",
    "@expo/metro-runtime": "~58.0.14",
    "@neondatabase/serverless": "^1.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-auth": "^1.7.12",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "kysely": "^0.29.7",
    "lucide-react-native": "^1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eas-cli": "^25.2.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests worker scripts",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "build:web": "expo export --platform web",
    "build:mobile": "expo export --platform android --platform ios --output-dir dist-mobile",
    "worker:check": "wrangler deploy --dry-run --env staging",
    "worker:staging": "wrangler deploy --env staging",
    "db:migrate": "node scripts/migrate.cjs",
    "demo:ledger": "tsc -p tsconfig.test.json && node scripts/ledger-demo.cjs",
    "demo:auth": "tsc -p tsconfig.test.json && node scripts/auth-demo.cjs"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "private": true
}
