{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nestwise-development",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    "development": { "name": "nestwise-development", "workers_dev": false, "vars": { "ENVIRONMENT": "development" } },
    "staging": {
      "name": "nestwise-staging", "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/v1/*", "/health"]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_ENABLED": "true",
        "AUTH_BASE_URL": "https://nestwise-staging.alexeasyrepair.workers.dev",
        "AUTH_WEB_ORIGIN": "https://nestwise-staging.alexeasyrepair.workers.dev"
      }
    },
    "production": { "name": "nestwise-production", "workers_dev": false, "vars": { "ENVIRONMENT": "production" } }
  }
}
