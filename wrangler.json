{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nestwise-development",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "development"
  },
  "env": {
    "development": {
      "name": "nestwise-development",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "development"
      }
    },
    "staging": {
      "name": "nestwise-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/v1/*",
          "/health"
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_ENABLED": "true",
        "AUTH_BASE_URL": "https://nestwise-staging.alexeasyrepair.workers.dev",
        "AUTH_WEB_ORIGIN": "https://nestwise-staging.alexeasyrepair.workers.dev",
        "NESTWISE_OCR_ENABLED": "true",
        "NESTWISE_OCR_MODEL": "gpt-6-luna"
      },
      "r2_buckets": [
        {
          "binding": "STATEMENTS",
          "bucket_name": "nestwise-documents-staging"
        },
        {
          "binding": "STATEMENTS_BACKUP",
          "bucket_name": "nestwise-documents-staging-backup"
        }
      ]
    },
    "production": {
      "name": "nestwise-production",
      "services": [{"binding":"CRM_LABEL_SOURCE","service":"alex-crm-api"}],
      "workers_dev": false,
      "routes": [{"pattern": "nestwise.universestitch.com", "custom_domain": true}],
      "observability": {
        "enabled": true,
        "logs": {"enabled": true, "invocation_logs": false, "head_sampling_rate": 1, "persist": true}
      },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/v1/*", "/health"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_ENABLED": "true",
        "PRODUCTION_RELEASE_APPROVED": "nestwise-production-v1",
        "AUTH_BASE_URL": "https://nestwise.universestitch.com",
        "AUTH_WEB_ORIGIN": "https://nestwise.universestitch.com",
        "FINANCIAL_INGESTION_ENABLED": "false",
        "NESTWISE_OCR_ENABLED": "true",
        "NESTWISE_OCR_MODEL": "gpt-6-luna"
      },
      "r2_buckets": [
        {"binding": "STATEMENTS", "bucket_name": "nestwise-documents-production"},
        {"binding": "STATEMENTS_BACKUP", "bucket_name": "nestwise-documents-production-backup"}
      ]
    }
  }
}
